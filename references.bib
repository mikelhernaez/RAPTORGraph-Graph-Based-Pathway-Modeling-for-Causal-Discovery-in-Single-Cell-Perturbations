@misc{wang_how_2024,
	title = {How {Transformers} {Get} {Rich}: {Approximation} and {Dynamics} {Analysis}},
	copyright = {arXiv.org perpetual, non-exclusive license},
	shorttitle = {How {Transformers} {Get} {Rich}},
	url = {https://arxiv.org/abs/2410.11474},
	doi = {10.48550/ARXIV.2410.11474},
	abstract = {Transformers have demonstrated exceptional in-context learning capabilities, yet the theoretical understanding of the underlying mechanisms remains limited. A recent work (Elhage et al., 2021) identified a ``rich'' in-context mechanism known as induction head, contrasting with ``lazy'' \$n\$-gram models that overlook long-range dependencies. In this work, we provide both approximation and dynamics analyses of how transformers implement induction heads. In the \{{\textbackslash}em approximation\} analysis, we formalize both standard and generalized induction head mechanisms, and examine how transformers can efficiently implement them, with an emphasis on the distinct role of each transformer submodule. For the \{{\textbackslash}em dynamics\} analysis, we study the training dynamics on a synthetic mixed target, composed of a 4-gram and an in-context 2-gram component. This controlled setting allows us to precisely characterize the entire training process and uncover an \{{\textbackslash}em abrupt transition\} from lazy (4-gram) to rich (induction head) mechanisms as training progresses.},
	urldate = {2025-09-15},
	publisher = {arXiv},
	author = {Wang, Mingze and Yu, Ruoxi and E, Weinan and Wu, Lei},
	year = {2024},
	note = {Version Number: 3},
